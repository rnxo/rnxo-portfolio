{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rnxo-portfolio",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "routes": [
    { "pattern": "skyremt.dev", "custom_domain": true},
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-dev-arcticle-db",
      "database_id": "1c299a36-7db8-45b9-abc4-fd0bc05619da",
      "migrations_dir": "migrations",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "my-dev-arcticle-media",
    },
  ],
}
